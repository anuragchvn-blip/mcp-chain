# Environment Variables for ChainMind MCP Server

# ===== Blockchain RPC Endpoints =====
# Ethereum RPC URL (e.g., Infura, Alchemy, or public endpoint)
ETH_RPC_URL=https://eth.llamarpc.com

# Solana RPC URL (mainnet-beta, devnet, or custom)
SOL_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Supabase Configuration (Optional) =====
# Used for transaction logging and analytics
# Leave empty to disable Supabase logging
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===== Notes =====
# - Private keys should NEVER be stored in environment variables
# - They should only be passed via API requests (server-side only)
# - For production, use secure RPC providers with rate limiting
# - Consider adding authentication to protect your APIs
